# Copy to .env.local and fill in your own values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecomkiji
MONGODB_DB=ecomkiji
JWT_SECRET=replace-with-a-long-random-string
SEED_SECRET=replace-with-a-secret
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Super Admin
# Optional second administrator, also created by `npm run seed`. Leave blank to
# skip. Useful for giving the site owner their own login without editing source.
SEED_ADMIN2_EMAIL=
SEED_ADMIN2_PASSWORD=
SEED_ADMIN2_NAME=Administrator
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Single public contact address: site enquiries, support, and the payment
# gateway account all use this one address.
NEXT_PUBLIC_SITE_EMAIL=fahimahamedweb@gmail.com
# Public origin, used for absolute URLs in metadata and outbound email.
NEXT_PUBLIC_SITE_URL=https://getyoursoftware.top

# Official WhatsApp number for listing orders & inquiries
NEXT_PUBLIC_WHATSAPP=+8801706617723
NEXT_PUBLIC_WHATSAPP_DISPLAY=+880 1706-617723

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-EQPRMKK1ZX
